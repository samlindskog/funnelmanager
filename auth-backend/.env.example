# Auth service — copy to auth-backend/.env for non-Docker runs.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Session lifetime in seconds (default 86400 = 1 day).
SESSION_TTL_SECONDS=86400
# Non-Docker local run: point at a reachable Redis (127.0.0.1). In Docker Compose
# the auth service uses redis://redis:6379/0 from the root .env.
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost
