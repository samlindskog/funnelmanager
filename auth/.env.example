# Auth service — copy to auth/.env for non-Docker runs.
# Bootstrap admin (created if missing on startup, never updated afterwards).
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Session lifetime in seconds (default 86400 = 1 day).
SESSION_TTL_SECONDS=86400
# OPA decision service (non-Docker: run `opa run --server` locally).
OPA_URL=http://127.0.0.1:8181
# JSON list of hub apps; blank = default Search + Mail entries.
WEB_APPS=
# Non-Docker local run: point at a reachable Redis (127.0.0.1). In Docker Compose
# the auth service uses redis://redis:6379/0 from the root .env.
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost
