{
  "_comment": "Production realm TEMPLATE. Copy OUT of the repo, replace every REPLACE-* secret and x9bc433.win host, then point KEYCLOAK_REALM_FILE (compose) or the keycloak-realm secret (k3s) at the copy. Unlike the dev realm this imports NO human users — create them in the Keycloak console and assign realm roles there.",
  "realm": "funnelmanager",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access to every Funnel Manager service (service:* in OPA data documents / fm_runtime grants). Composite of the per-service *-access roles so an admin can reach every API even where policy is later narrowed to specific service grants.",
        "composite": true,
        "composites": {
          "realm": [
            "search-access",
            "mail-access",
            "jobs-access",
            "agents-access"
          ]
        }
      },
      {
        "name": "internal-service",
        "description": "Service-account identity for detached background work (search/mcp continue jobs under client credentials once the principal's token expires) — grants leads API access only (OPA data documents / fm_runtime grants)"
      },
      {
        "name": "search-access",
        "description": "Human access to the search API (/api/search). Per-service access role: gates whether a principal may call the search API; within the service all users see the same data. Assign in the Keycloak console. Mirrors grants.py + data.json."
      },
      {
        "name": "mail-access",
        "description": "Human access to the mail API (/api/mail, all methods). Per-service access role — gates API access, not rows. Assign to human users in the Keycloak console. Mirrors fm_runtime/grants.py + deploy/policy/data.json."
      },
      {
        "name": "jobs-access",
        "description": "Human access to the jobs API (/api/jobs, all methods). Per-service access role — gates API access, not rows. Assign to human users in the Keycloak console. Mirrors fm_runtime/grants.py + deploy/policy/data.json."
      },
      {
        "name": "agents-access",
        "description": "Human access to the agents API (/api/agents, all methods). Per-service access role — gates API access, not rows. Assign to human users in the Keycloak console. Mirrors fm_runtime/grants.py + deploy/policy/data.json."
      },
      {
        "name": "jobs-internal",
        "description": "Machine-only role for the jobs service account (azp=jobs, client-credentials) reaching producers' /internal/jobs/* stream + control on search+agents. Never a human; the acting human is audit metadata. Mirrors grants.py + data.json."
      }
    ]
  },
  "users": [
    {
      "username": "service-account-search",
      "enabled": true,
      "serviceAccountClientId": "search",
      "realmRoles": [
        "internal-service"
      ]
    },
    {
      "username": "service-account-mcp",
      "enabled": true,
      "serviceAccountClientId": "mcp",
      "realmRoles": [
        "internal-service"
      ]
    },
    {
      "username": "service-account-jobs",
      "enabled": true,
      "serviceAccountClientId": "jobs",
      "realmRoles": [
        "jobs-internal"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "svc-leads",
      "protocol": "openid-connect",
      "description": "Adds the leads service to the token audience (used by RFC 8693 exchange)",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-leads",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "leads",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "svc-search",
      "protocol": "openid-connect",
      "description": "Adds the search service to the token audience",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-search",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "search",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "svc-mail",
      "protocol": "openid-connect",
      "description": "Adds the mail service to the token audience",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-mail",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mail",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "svc-mcp",
      "protocol": "openid-connect",
      "description": "Adds the mcp service to the token audience",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "svc-jobs",
      "protocol": "openid-connect",
      "description": "Adds the jobs service to the token audience (used by RFC 8693 exchange)",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-jobs",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jobs",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "svc-agents",
      "protocol": "openid-connect",
      "description": "Adds the agents service to the token audience (used by RFC 8693 exchange)",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-agents",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agents",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fm-origin",
      "protocol": "openid-connect",
      "description": "Propagates fm_origin across RFC 8693 exchanges: a script mapper (feature scripts) copies the inbound subject token's fm_origin onto the issued token (default user), so an agent origin survives every hop. Reads only the subject token, unforgeable.",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "fm-origin-passthrough",
          "protocol": "openid-connect",
          "protocolMapper": "script-fm-origin-passthrough.js",
          "config": {
            "claim.name": "fm_origin",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Funnel Manager hub + search app + mail app (browser)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://x9bc433.win/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://x9bc433.win/*"
      },
      "protocolMappers": [
        {
          "name": "aud-search",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "search",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mail",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mail",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "fm-origin"
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana (observability) OIDC login",
      "publicClient": false,
      "secret": "REPLACE-grafana-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://grafana.x9bc433.win/login/generic_oauth"
      ],
      "webOrigins": [
        "https://grafana.x9bc433.win"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles"
      ]
    },
    {
      "clientId": "search",
      "name": "Search backend service identity",
      "publicClient": false,
      "secret": "REPLACE-search-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "optionalClientScopes": [
        "svc-leads",
        "svc-mail"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "fm-origin"
      ]
    },
    {
      "clientId": "leads",
      "name": "Leads backend service identity",
      "publicClient": false,
      "secret": "REPLACE-leads-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "fm-origin"
      ]
    },
    {
      "clientId": "mail",
      "name": "Mail backend service identity",
      "publicClient": false,
      "secret": "REPLACE-mail-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "fm-origin"
      ]
    },
    {
      "clientId": "mcp",
      "name": "MCP server service identity",
      "publicClient": false,
      "secret": "REPLACE-mcp-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "optionalClientScopes": [
        "svc-leads",
        "svc-search",
        "svc-jobs",
        "svc-mail"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "fm-origin"
      ]
    },
    {
      "clientId": "jobs",
      "name": "Jobs service identity",
      "publicClient": false,
      "secret": "REPLACE-jobs-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "optionalClientScopes": [
        "svc-search",
        "svc-agents"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "fm-origin"
      ]
    },
    {
      "clientId": "agents",
      "name": "Agents service identity (runs runtime AI agents; fm_origin=agent)",
      "publicClient": false,
      "secret": "REPLACE-agents-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "fm-origin-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fm_origin",
            "claim.value": "agent",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "optionalClientScopes": [
        "svc-mcp"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles"
      ]
    }
  ]
}
