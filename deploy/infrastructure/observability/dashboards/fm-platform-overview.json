  {
   "type": "table",
   "title": "Services \u2014 current RED (click a service to drill down)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(fm_http_requests_total{route!~\"/healthz|/readyz|/metrics\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "100 * (sum by (service) (rate(fm_http_requests_total{status!~\"5..\",route!~\"/healthz|/readyz|/metrics\"}[5m])) / sum by (service) (rate(fm_http_requests_total{route!~\"/healthz|/readyz|/metrics\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, service) (rate(fm_http_request_duration_seconds_bucket{route!~\"/healthz|/readyz|/metrics\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "count by (service) (count by (service, pod) (fm_http_requests_total))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "service",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true
      },
      "renameByName": {
       "Value #A": "req/s",
       "Value #B": "success %",
       "Value #C": "p99 (s)",
       "Value #D": "pods"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false,
      "filterable": true
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": []
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "req/s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "reqps"
       },
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "success %"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
