     "refId": "A",
     "expr": "(sum(rate(istio_requests_total{reporter=\"destination\", destination_workload=\"$svc-canary\", response_code!~\"5..\"}[5m])) / sum(rate(istio_requests_total{reporter=\"destination\", destination_workload=\"$svc-canary\"}[5m]))) - (sum(rate(istio_requests_total{reporter=\"destination\", destination_workload=\"$svc\", response_code!~\"5..\"}[5m])) / sum(rate(istio_requests_total{reporter=\"destination\", destination_workload=\"$svc\"}[5m])))",
