  {
   "type": "stat",
   "title": "OPA HTTP API P99",
   "description": "OPA's HTTP endpoints only (health/diagnostics) \u2014 the gRPC ext_authz decision path isn't in this metric. Still a responsiveness canary for the process.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"opa\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
