  {
   "type": "table",
   "title": "CPU quota \u2014 usage vs requests & limits",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", image!=\"\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "sum by (pod) (kube_pod_container_resource_requests{resource=\"cpu\", namespace=~\"$namespace\", pod=~\"$pod\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", image!=\"\"}[5m])) / sum by (pod) (kube_pod_container_resource_requests{resource=\"cpu\", namespace=~\"$namespace\", pod=~\"$pod\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "sum by (pod) (kube_pod_container_resource_limits{resource=\"cpu\", namespace=~\"$namespace\", pod=~\"$pod\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "E",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", image!=\"\"}[5m])) / sum by (pod) (kube_pod_container_resource_limits{resource=\"cpu\", namespace=~\"$namespace\", pod=~\"$pod\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "pod",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true
      },
      "renameByName": {
       "Value #A": "usage (cores)",
       "Value #B": "requests",
       "Value #C": "usage/requests",
       "Value #D": "limits",
       "Value #E": "usage/limits"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false,
      "filterable": true
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": []
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "usage (cores)"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 3
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "requests"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "limits"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^usage\\//"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "value": null,
           "color": "green"
          },
          {
           "value": 0.9,
           "color": "yellow"
          },
          {
           "value": 1.1,
           "color": "red"
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    },
    "sortBy": [
     {
      "displayName": "usage (cores)",
      "desc": true
     }
    ]
   },
   "id": 11,
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 15
   }
