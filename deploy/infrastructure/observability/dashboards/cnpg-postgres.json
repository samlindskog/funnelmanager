  {
   "type": "timeseries",
   "title": "Buffer cache hit ratio",
   "description": "Sustained <99% on these small DBs usually means shared_buffers is too small or a seq-scan storm.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cnpg_cluster) (rate(cnpg_pg_stat_database_blks_hit{cnpg_cluster=~\"$cluster\"}[$__rate_interval])) / (sum by (cnpg_cluster) (rate(cnpg_pg_stat_database_blks_hit{cnpg_cluster=~\"$cluster\"}[$__rate_interval])) + sum by (cnpg_cluster) (rate(cnpg_pg_stat_database_blks_read{cnpg_cluster=~\"$cluster\"}[$__rate_interval])))",
     "datasource": {
