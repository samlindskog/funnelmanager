  {
   "type": "table",
   "title": "User actions by data-testid (window total)",
   "description": "The data-testid is both the Faro user-action name and the Playwright selector (drive-canary).",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(20, sum by (event_data_userActionName) (count_over_time({job=\"faro\"} | logfmt | kind=\"event\" | event_data_userActionName != \"\" [$__range])))",
     "datasource": {
      "type": "loki",
      "uid": "loki"
