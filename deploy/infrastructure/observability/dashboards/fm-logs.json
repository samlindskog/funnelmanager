   "id": 6,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 10
   }
  },
  {
   "type": "table",
   "title": "Noisiest pods (window total)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (pod) (count_over_time({job=\"fluent-bit\"} [$__range])))",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "instant"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "lines"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false,
      "filterable": true
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    },
    "sortBy": [
     {
      "displayName": "lines",
      "desc": true
     }
    ]
   },
   "id": 7,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 10
