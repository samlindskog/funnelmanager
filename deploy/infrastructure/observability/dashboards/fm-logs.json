  {
   "type": "timeseries",
   "title": "error-level lines by service (all namespaces)",
   "description": "Uses Loki's detected_level (works for every log format, incl. non-JSON infra logs).",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service_name) (count_over_time({job=\"fluent-bit\", service_name=~\"$logsvc\"} | detected_level=~\"error|critical\" [$__auto]))",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "legendFormat": "{{service_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "gradientMode": "none",
      "showPoints": "never",
      "pointSize": 4,
      "spanNulls": false,
      "insertNulls": false,
      "barAlignment": 0,
      "axisPlacement": "auto",
      "axisBorderShow": false,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 5,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 10
   }
  },
  {
   "type": "timeseries",
   "title": "prod backends by level (fm_runtime JSON)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (level) (count_over_time({namespace=\"prod\"} | json | level != \"\" | __error__=\"\" [$__auto]))",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "legendFormat": "{{level}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "gradientMode": "none",
      "showPoints": "never",
      "pointSize": 4,
      "spanNulls": false,
      "insertNulls": false,
      "barAlignment": 0,
      "axisPlacement": "auto",
      "axisBorderShow": false,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "info"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "debug"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "warning"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "critical"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "dark-red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
