{
 "uid": "fm-logs",
 "title": "FM \u00b7 Logs & Errors",
 "description": "Loki view across every service. Backend lines are fm_runtime structured JSON ({service_name=...} | json); browser RUM lands under {job=\"faro\"}. Log-line TraceIDs deep-link to Tempo.",
 "tags": [
  "funnelmanager",
  "logs"
 ],
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "timezone": "browser",
 "fiscalYearStartMonth": 0,
 "weekStart": "",
 "refresh": "1m",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "timepicker": {},
 "links": [
  {
   "type": "dashboards",
   "title": "Funnel Manager",
   "tags": [
    "funnelmanager"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link",
   "targetBlank": false,
   "url": ""
  }
 ],
 "templating": {
  "list": [
   {
    "name": "logsvc",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "type": 1,
     "label": "service_name",
     "stream": ""
    },
    "refresh": 2,
    "regex": "",
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "options": [],
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ],
     "selected": true
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "name": "Annotations & Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Volume",
   "collapsed": false,
   "panels": [],
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "timeseries",
   "title": "Log lines by service",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service_name) (count_over_time({job=\"fluent-bit\", service_name=~\"$logsvc\"} [$__auto]))",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "legendFormat": "{{service_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "gradientMode": "none",
      "showPoints": "never",
      "pointSize": 4,
      "spanNulls": false,
      "insertNulls": false,
      "barAlignment": 0,
      "axisPlacement": "auto",
      "axisBorderShow": false,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 2,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Log throughput (bytes)",
   "description": "Loki bills by bytes scanned \u2014 this is who is noisy.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service_name) (bytes_over_time({job=\"fluent-bit\", service_name=~\"$logsvc\"} [$__auto]))",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "legendFormat": "{{service_name}}"
    }
   ],
   "fieldConfig": {
