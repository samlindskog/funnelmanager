  {
   "type": "stat",
   "title": "Request rate",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(fm_http_requests_total{service=~\"$service\", route!~\"/healthz|/readyz|/metrics\", route=~\"$route\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "blue"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "wideLayout": true,
    "percentChangeColorMode": "standard",
    "showPercentChange": false
   },
   "id": 2,
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "Success rate",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (sum(rate(fm_http_requests_total{status!~\"5..\",service=~\"$service\", route!~\"/healthz|/readyz|/metrics\", route=~\"$route\"}[5m])) / sum(rate(fm_http_requests_total{service=~\"$service\", route!~\"/healthz|/readyz|/metrics\", route=~\"$route\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "red"
       },
       {
        "value": 99,
        "color": "yellow"
       },
       {
        "value": 99.9,
        "color": "green"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "wideLayout": true,
    "percentChangeColorMode": "standard",
    "showPercentChange": false
   },
   "id": 3,
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   }
  },
