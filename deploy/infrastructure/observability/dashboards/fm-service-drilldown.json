     "uid": "prometheus"
    },
    "query": "label_values(fm_http_requests_total, service)",
    "refresh": 2,
    "regex": "",
    "sort": 1,
    "multi": false,
    "includeAll": false,
    "options": [],
    "current": {
     "text": "search",
     "value": "search",
     "selected": true
    }
   },
   {
    "name": "route",
    "label": "route",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(fm_http_requests_total{service=~\"$service\"}, route)",
    "refresh": 2,
    "regex": "",
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "options": [],
    "current": {
     "text": [
      "All"
