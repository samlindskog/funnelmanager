     "expr": "100 * (sum by (route, method) (rate(fm_http_requests_total{status!~\"5..\",service=~\"$service\", route!~\"/healthz|/readyz|/metrics\", route=~\"$route\"}[5m])) / sum by (route, method) (rate(fm_http_requests_total{service=~\"$service\", route!~\"/healthz|/readyz|/metrics\", route=~\"$route\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, route, method) (rate(fm_http_request_duration_seconds_bucket{service=~\"$service\", route!~\"/healthz|/readyz|/metrics\", route=~\"$route\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
