# Local-cluster settings — copy to settings.env (gitignored) and fill in.
# bootstrap-local.sh sources this to create the dev-namespace secrets and
# the fm-web ConfigMap.

# Apollo (leads backend). Blank = searches against Apollo will fail, but the
# platform itself still comes up.
APOLLO_API_KEY=
APOLLO_WEBHOOK_SECRET=local-webhook-secret

# OpenAI (embeddings). Blank = similarity search degrades gracefully.
OPENAI_API_KEY=

# Google OAuth client for the mail service (optional locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ngrok static domain for Apollo webhooks (e.g. my-name.ngrok-free.app).
# Blank = webhooks disabled; sync search/enrich still works.
NGROK_DOMAIN=

# Extra hub tiles (JSON list) — usually blank.
WEB_APPS=
