# Knowledge backend — local non-Docker run (copy to knowledge/.env)

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://funnel:funnel@localhost:5432/funnelmanager_knowledge

# --- Graph store (Neo4j; optional — absent => graph features degrade) ------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowledge-dev

# --- OpenAI (extraction + embeddings; optional — absent => fuzzy/graph degrade)
OPENAI_API_KEY=
KNOWLEDGE_LLM_MODEL=gpt-4.1
KNOWLEDGE_SMALL_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Source services (read-only; exchange edges knowledge->{mail,search,agents})
MAIL_BACKEND_URL=http://localhost:8004
SEARCH_BACKEND_URL=http://localhost:8000
AGENTS_BACKEND_URL=http://localhost:8006

# --- Sync + cost guards ----------------------------------------------------
SYNC_INTERVAL_SECONDS=300
GRAPH_INGEST_SOURCES=searches,mail_campaigns
SESSION_INGEST_ENABLED=true
GRAPH_AUTO_BATCH=25
KNOWLEDGE_SYNC_CONFIRM_EPISODES=200
FUZZY_THRESHOLD_DEFAULT=0.30

# --- Graphiti operational knobs -------------------------------------------
SEMAPHORE_LIMIT=5
GRAPHITI_TELEMETRY_ENABLED=false

# --- Identity / authz (fm_runtime FM_* vars) -------------------------------
# This service's audience is `knowledge`. Internal calls EXCHANGE, never forward.
FM_SERVICE_NAME=knowledge
# FM_OIDC_ISSUER=http://localhost:8080/realms/funnelmanager
# FM_OIDC_CLIENT_ID=knowledge
# FM_OIDC_CLIENT_SECRET=dev-knowledge-secret
# FM_JWT_VERIFY=true          # verify JWTs locally outside the mesh
# FM_ENFORCE_GRANTS=true      # apply role grants in-process (compose)
