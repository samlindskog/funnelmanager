searchui/dist/

# Docker / env
.env
.env.prod
.env.local
# Local-cluster filled-in settings (the tracked template is settings.env.example)
deploy/local/settings.env

# Credentials / keys — defensive; none are tracked today, this prevents an
# accidental future commit now that the repo is public.
*.pem
*.key
*.p12
*.pfx
kubeconfig
*.kubeconfig
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret

# OS / IDE
.DS_Store
.idea/
.vscode/
*.log

# Claude Code local settings
.claude/settings.local.json

# Throwaway multi-agent workflow runners (operational, not tracked)
.claude/workflows/

# Playwright MCP session artifacts (snapshots/console logs)
.playwright-mcp/

# Keycloak provider JAR — a deterministic build intermediate (build.sh);
# the delivery artifact is the generated providers-configmap.yaml.
deploy/keycloak/providers/fm-origin-provider.jar
