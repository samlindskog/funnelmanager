# Python
__pycache__/
*.py[cod]
.venv/
venv/
backend/.env
search/*.db
mail/*.db
*.egg-info/
build/
dist/
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
mailui/node_modules/
mailui/dist/
agentsui/node_modules/
agentsui/dist/
