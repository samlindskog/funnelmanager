# Mail backend — local non-Docker run (copy to mail/.env)
DATABASE_URL=postgresql+asyncpg://funnel:funnel@localhost:5432/funnelmanager_mail
AUTH_BACKEND_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth client ("Web application"). Create at
# https://console.cloud.google.com/apis/credentials with the Gmail API enabled;
# register OAUTH_REDIRECT_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/api/mail/oauth/callback

# Where the browser lands after connecting a mailbox (the hub Mail app).
MAIL_APP_URL=/mail

# Background sync cadence + backfill budget (pages of 100 msgs per cycle).
SYNC_INTERVAL_SECONDS=180
BACKFILL_PAGES_PER_CYCLE=10
