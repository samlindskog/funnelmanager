# Jobs backend — local non-Docker run (copy to jobs/.env)

# --- Storage ---------------------------------------------------------------
# Dedicated logical database; created at startup if missing.
DATABASE_URL=postgresql+asyncpg://funnel:funnel@localhost:5432/funnelmanager_jobs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Producer registry (CONFIG-DRIVEN) -------------------------------------
# Comma-separated `name=base_url` pairs. `name` is BOTH the token-exchange
# audience (svc scope jobs-><name> must exist in Keycloak) AND the Job.app value
# recorded for that producer's jobs. v1 producers are `search` + `agents` only;
# add mail/others here (plus the svc scope) with NO code change.
#   Production/dev in-cluster example:
JOBS_PRODUCERS=search=http://search:8000,agents=http://agents:8006
# Local verification against the stub producer on :8000 (see scripts/stub_producer.py):
#   JOBS_PRODUCERS=search=http://localhost:8000

# Turn the background subscriber off to run the MCP API in isolation.
SUBSCRIBER_ENABLED=true
SUBSCRIBER_BACKOFF_INITIAL_SECONDS=1
SUBSCRIBER_BACKOFF_MAX_SECONDS=30
# Timeout for outbound control-proxy calls to a producer.
CONTROL_TIMEOUT_SECONDS=15

# --- Identity / authz (fm_runtime FM_* vars) -------------------------------
# This service's audience is `jobs`. Outbound hops EXCHANGE (never forward):
# jobs->search / jobs->agents for the stream + control proxy. Bare-dev
# passthrough (no token endpoint set) skips exchange — fine for local testing
# against the stub, never valid in the mesh.
FM_SERVICE_NAME=jobs
# FM_OIDC_ISSUER=http://localhost:8080/realms/funnelmanager
# FM_OIDC_CLIENT_ID=jobs
# FM_OIDC_CLIENT_SECRET=
# FM_JWT_VERIFY=true          # verify JWTs locally outside the mesh
# FM_ENFORCE_GRANTS=true      # apply role grants in-process (compose)
