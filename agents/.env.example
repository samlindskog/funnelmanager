# agents service (:8006) — runtime AI agents (pydantic-ai) that act EXCLUSIVELY
# through the internal MCP server, as the human, via RFC 8693 exchange
# (fm_origin=agent). See CLAUDE.md and docs/agent-build-plan.md.

# Own Postgres database. Created at startup if missing (see database.init_db).
DATABASE_URL=postgresql+asyncpg://funnel:funnel@agents-db:5432/funnelmanager_agents

# Internal MCP server (streamable HTTP mount). The runtime agent's whole
# capability + situational-awareness surface. Never nginx-routed.
MCP_URL=http://mcp:8003/mcp

# The *runtime* agents' LLM (OpenAI). Key is server-side only, never hardcoded.
OPENAI_API_KEY=
# OpenAI chat model the runtime agents plan with. Configurable; may be given
# with or without the `openai:` provider prefix (default provider is openai).
AGENTS_LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# --- Phase 1 telemetry (opt-in; agents is the ONE service that enables it) ----
# Read directly by fm_runtime/logfire, not by app/config.py. Unset here (and in
# prod) => logfire is never imported and the service pays nothing. In dev/canary
# set FM_LOGFIRE=1 (the canary build sets it via build-arg) to emit fine-grained
# spans: fm_runtime instruments FastAPI+httpx, and app/main.py additionally calls
# logfire.instrument_pydantic_ai() so the runtime Agent's model/tool calls +
# token usage become spans. Requires `pip install` of the logfire deps in
# requirements.txt (agents ships them; other services do not).
# FM_LOGFIRE=1
# Logfire-cloud write token — spans reach the cloud only when this is set
# (send_to_logfire='if-token-present'). Leave unset in prod. Needed to run
# scripts/logfire_smoke.py against Logfire.
# LOGFIRE_TOKEN=
# OTLP/gRPC collector (Tempo) for dual export so app + mesh spans share one
# trace id without a Logfire-cloud dependency. Optional.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc:4317

# --- Identity / authz (fm_runtime; audience `agents`, svc scope agents->mcp) --
FM_SERVICE_NAME=agents
FM_JWT_VERIFY=true
FM_OIDC_ISSUER=http://localhost:8080/realms/funnelmanager
FM_OIDC_TOKEN_URL=http://keycloak:8080/realms/funnelmanager/protocol/openid-connect/token
FM_OIDC_JWKS_URL=http://keycloak:8080/realms/funnelmanager/protocol/openid-connect/certs
FM_OIDC_CLIENT_ID=agents
FM_OIDC_CLIENT_SECRET=dev-agents-secret
FM_ENFORCE_GRANTS=true
