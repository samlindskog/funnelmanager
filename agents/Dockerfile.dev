# Build context: repository root. Source is bind-mounted (./agents -> /app,
# ./libs/fm_runtime -> /libs/fm_runtime for live lib edits via -e install).
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY libs/fm_runtime /libs/fm_runtime
COPY agents/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -e '/libs/fm_runtime[tracing]' -r /tmp/requirements.txt
EXPOSE 8006
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8006", "--reload"]
