{
  "agents": {
    "defaults": {
      // Anthropic is wired but disabled until ANTHROPIC_API_KEY lands in .env —
      // when it does, switch primary to "anthropic/claude-opus-4-8".
      "model": { "primary": "openai/gpt-5.6" }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": { "mode": "token" }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing"
    }
  },
  "mcp": {
    "servers": {
      "funnelmanager": {
        "url": "http://mcp-server:8003/mcp",
        "transport": "streamable-http",
        "supportsParallelToolCalls": true
      }
    }
  }
}
