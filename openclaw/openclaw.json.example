{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-sol"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing"
    }
  },
  "mcp": {
    "servers": {
      "funnelmanager": {
        "url": "http://mcp:8003/mcp",
        "transport": "streamable-http",
        "supportsParallelToolCalls": true
      }
    }
  },
  "plugins": {
    "entries": {
      "funnelmanager-auth": {
        "enabled": true,
        "config": {
          "authBackendUrl": "http://auth:8002"
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": []
  }
}
