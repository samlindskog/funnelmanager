# Production environment — copy to .env.prod and fill in real values
# NOTE: this compose deployment is the interim bridge until the k3s cluster
# (deploy/) takes over.
DOMAIN=example.com

# Keycloak (sole OIDC issuer). KC_HOSTNAME / FM_OIDC_ISSUER must be the
# browser-facing HTTPS URL (put a TLS reverse proxy in front of the published
# Keycloak port). Manage users/roles in the Keycloak console.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=replace-with-a-strong-password
KC_HOSTNAME=https://kc.example.com
FM_OIDC_ISSUER=https://kc.example.com/realms/funnelmanager
# Per-service confidential client secrets — must match the imported realm.
# REQUIRED: a hardened realm export kept OUT of git (start from
# deploy/keycloak/realm-funnelmanager-prod.example.json). Never point this at
# the tracked dev realm — it imports an admin/admin application user and
# published client secrets; compose refuses to start without this set.
KEYCLOAK_REALM_FILE=/srv/funnelmanager/realm-funnelmanager-prod.json
FM_OIDC_SEARCH_SECRET=replace-with-the-realm-search-secret
FM_OIDC_LEADS_SECRET=replace-with-the-realm-leads-secret
FM_OIDC_MAIL_SECRET=replace-with-the-realm-mail-secret
FM_OIDC_MCP_SECRET=replace-with-the-realm-mcp-secret
FM_OIDC_JOBS_SECRET=replace-with-the-realm-jobs-secret
FM_OIDC_AGENTS_SECRET=replace-with-the-realm-agents-secret
# Principle-4 human-approval HMAC secret. agents MINTS approval tokens for
# agent-initiated over-threshold actions; leads + mail VERIFY them. Must be
# ONE shared high-entropy value across agents/leads/mail — if unset, every
# agent over-threshold action is permanently blocked (fail-closed).
FM_CONFIRM_APPROVAL_SECRET=replace-with-a-shared-high-entropy-secret
# Public browser client for the hub/search/mail/agents apps.
FRONTEND_OIDC_CLIENT_ID=frontend

# JSON hub app list baked into /config.js. Setting this REPLACES the built-in
# Search+Mail default, so list every tile (each is probe-gated by its /whoami).
WEB_APPS=[{"name":"Search","description":"Apollo person/company search","url":"/search/","probe":"/api/search/whoami"},{"name":"Mail","description":"Google Workspace inboxes & sending","url":"/mail/","probe":"/api/mail/whoami"},{"name":"Agents","description":"AI agents that run tasks for you","url":"/agents/","probe":"/api/agents/whoami"}]
# Keep false in prod: MCP clients must pass the acting principal's token.
MCP_SHARED_LOGIN_FALLBACK=false
APOLLO_API_KEY=your_apollo_api_key_here

# Comma-separated origins for the browser (include https://your-domain)
CORS_ORIGINS=https://example.com

POSTGRES_USER=funnel
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=funnelmanager
DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@db:5432/funnelmanager

# Mail service database — dedicated mail-db container (reuses POSTGRES_USER /
# POSTGRES_PASSWORD for its bootstrap).
MAIL_DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@mail-db:5432/funnelmanager_mail

# Jobs service database — dedicated jobs-db container (reuses POSTGRES_USER /
# POSTGRES_PASSWORD for its bootstrap).
JOBS_DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@jobs-db:5432/funnelmanager_jobs
# Config-driven job producers (v1 = search + agents).
JOBS_PRODUCERS=search=http://search:8000,agents=http://agents:8006

# Knowledge service — dedicated knowledge-db (pgvector) + knowledge-graph (Neo4j).
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@knowledge-db:5432/funnelmanager_knowledge
KNOWLEDGE_GRAPH_PASSWORD=replace-with-a-strong-neo4j-password
FM_OIDC_KNOWLEDGE_SECRET=replace-with-the-realm-knowledge-secret
# Opt-in: set to http://knowledge:8007 to register the knowledge tools on mcp.
KNOWLEDGE_BACKEND_URL=

# Agents service database — dedicated agents-db container (reuses POSTGRES_USER /
# POSTGRES_PASSWORD for its bootstrap).
AGENTS_DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@agents-db:5432/funnelmanager_agents
# Runtime AI agents: internal MCP capability surface + OpenAI model (the key is
# OPENAI_API_KEY below, shared with leads).
MCP_URL=http://mcp:8003/mcp
AGENTS_LLM_MODEL=gpt-4o-mini

# Mail service — Google OAuth client for connecting Gmail/Workspace mailboxes
# (scopes: gmail.readonly + gmail.send). Register the callback as an authorized
# redirect URI: https://<DOMAIN>/api/mail/oauth/callback (derived from
# PUBLIC_BASE_URL when MAIL_OAUTH_REDIRECT_URL is left blank).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_OAUTH_REDIRECT_URL=
PUBLIC_BASE_URL=

MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=funnelmanager_leads
LEADS_BACKEND_URL=http://leads:8001
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=leads_embeds_v2
