# Production environment — copy to .env.prod and fill in real values
DOMAIN=example.com
# Bootstrap admin credentials — the auth service creates this admin-role user
# on startup if missing (never updates an existing user). Manage further
# users/roles in the hub UI.
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-password
# Session token lifetime in seconds (default 86400 = 1 day).
SESSION_TTL_SECONDS=86400
# JSON list of web apps on the post-login hub page (blank = OpenClaw at
# http://localhost:18789/, which matches the loopback publish + SSH tunnel).
WEB_APPS=
# Keep false in prod: MCP identity comes from OpenClaw per-profile tokens.
MCP_SHARED_LOGIN_FALLBACK=false
APOLLO_API_KEY=your_apollo_api_key_here

# Comma-separated origins for the browser (include https://your-domain)
CORS_ORIGINS=https://example.com

POSTGRES_USER=funnel
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=funnelmanager
DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@db:5432/funnelmanager

# Mail service database — dedicated mail-db container (reuses POSTGRES_USER /
# POSTGRES_PASSWORD for its bootstrap).
MAIL_DATABASE_URL=postgresql+asyncpg://funnel:replace-with-a-strong-db-password@mail-db:5432/funnelmanager_mail

# Mail service — Google OAuth client for connecting Gmail/Workspace mailboxes
# (scopes: gmail.readonly + gmail.send). Register the callback as an authorized
# redirect URI: https://<DOMAIN>/api/mail/oauth/callback (derived from
# PUBLIC_BASE_URL when MAIL_OAUTH_REDIRECT_URL is left blank).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_OAUTH_REDIRECT_URL=
PUBLIC_BASE_URL=

MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=funnelmanager_leads
LEADS_BACKEND_URL=http://leads:8001
# Central auth service (search backend validates session tokens against it).
AUTH_BACKEND_URL=http://auth:8002
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=leads_people

# OpenClaw (personal AI agent, Telegram + web Control UI on 127.0.0.1:18789)
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
