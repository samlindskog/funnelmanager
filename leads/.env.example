APOLLO_API_KEY=
# Public HTTPS origin Apollo can reach (ngrok in local dev).
# Webhook: {PUBLIC_BASE_URL}/api/leads/webhooks/apollo/{APOLLO_WEBHOOK_SECRET}
PUBLIC_BASE_URL=
APOLLO_WEBHOOK_SECRET=change-me-apollo-webhook-secret
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=funnelmanager_leads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=leads_people
