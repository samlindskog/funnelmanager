# Shared / local backend defaults (copy to backend/.env / leads-backend/.env / auth-backend/.env for non-Docker runs)
# Login credentials — consumed by the auth service, which issues session tokens.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Session token lifetime in seconds (default 86400 = 1 day).
SESSION_TTL_SECONDS=86400
APOLLO_API_KEY=
# Public origin Apollo can reach for waterfall/phone webhooks.
# Must be publicly reachable HTTPS (use an ngrok/tunnel URL in local Docker/dev).
# Example: https://abc123.ngrok-free.app
# Webhook path: {PUBLIC_BASE_URL}/api/leads/webhooks/apollo/{APOLLO_WEBHOOK_SECRET}
PUBLIC_BASE_URL=
# Generate a random value (e.g. `openssl rand -hex 32`); the webhook route
# refuses to serve when this is empty or left at a known placeholder.
APOLLO_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1
DATABASE_URL=postgresql+asyncpg://funnel:funnel@db:5432/funnelmanager
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=funnelmanager_leads
LEADS_BACKEND_URL=http://leads-backend:8001
# Central auth service (search backend validates session tokens against it).
AUTH_BACKEND_URL=http://auth-backend:8002
REDIS_URL=redis://redis:6379/0

# Person similarity search (leads-backend → OpenAI + Milvus)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=leads_people

# Postgres (used by compose)
POSTGRES_USER=funnel
POSTGRES_PASSWORD=funnel
POSTGRES_DB=funnelmanager

# OpenClaw (personal AI agent, Telegram + web Control UI at :18789)
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Anthropic API key for the OpenClaw agent model (console.anthropic.com)
ANTHROPIC_API_KEY=
# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
