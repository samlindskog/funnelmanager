# Shared / local backend defaults (copy to search/.env / leads/.env for non-Docker runs)

# Keycloak (sole OIDC issuer; dev compose imports deploy/keycloak/realm-*.json
# with dev-only client secrets and the admin/admin user). The issuer must be
# the browser-facing URL; the dev compose pins backend token/JWKS URLs to the
# keycloak container separately.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin
FM_OIDC_ISSUER=http://localhost:8080/realms/funnelmanager
# Per-service client secrets (dev defaults live in the compose file; set these
# only to override).
#FM_OIDC_SEARCH_SECRET=
#FM_OIDC_LEADS_SECRET=
#FM_OIDC_MAIL_SECRET=
#FM_OIDC_MCP_SECRET=
#FM_OIDC_AGENTS_SECRET=

# MCP server: allow tokenless tool calls to act as the MCP service identity
# via client credentials (dev compose defaults this to true).
MCP_SHARED_LOGIN_FALLBACK=
APOLLO_API_KEY=
# Public origin Apollo can reach for waterfall/phone webhooks.
# Must be publicly reachable HTTPS (use an ngrok/tunnel URL in local Docker/dev).
# Example: https://abc123.ngrok-free.app
# Webhook path: {PUBLIC_BASE_URL}/api/leads/webhooks/apollo/{APOLLO_WEBHOOK_SECRET}
PUBLIC_BASE_URL=
# Generate a random value (e.g. `openssl rand -hex 32`); the webhook route
# refuses to serve when this is empty or left at a known placeholder.
APOLLO_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1
DATABASE_URL=postgresql+asyncpg://funnel:funnel@db:5432/funnelmanager
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=funnelmanager_leads
LEADS_BACKEND_URL=http://leads:8001

# Mail service — Google OAuth client ("Web application" type) used to connect
# Gmail/Workspace mailboxes. Create at console.cloud.google.com/apis/credentials
# with the Gmail API enabled, and register the redirect URI below (defaults to
# http://localhost:8000/api/mail/oauth/callback in dev) on the client.
# Scopes used: gmail.readonly + gmail.send. Mailbox refresh tokens are stored
# in the mail service's dedicated Postgres container (funnelmanager_mail).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_OAUTH_REDIRECT_URL=

# Person similarity search (leads service → OpenAI + Milvus). OPENAI_API_KEY is
# shared with the agents service (runtime AI agents' LLM).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agents service — runtime AI agents (OpenAI via pydantic-ai). MCP_URL is the
# agent's only capability surface; AGENTS_LLM_MODEL is the chat model.
MCP_URL=http://mcp:8003/mcp
AGENTS_LLM_MODEL=gpt-4o-mini
# Agents telemetry opt-in (Logfire / pydantic-ai instrumentation). Default OFF.
# Set FM_LOGFIRE=1 + a LOGFIRE_TOKEN (Logfire write token) to mirror the canary's
# telemetry locally; OTEL_EXPORTER_OTLP_ENDPOINT optionally points at a local
# collector/Tempo (e.g. http://tempo:4317). In prod this is canary-only — the
# agents-canary manifest wires FM_LOGFIRE=1, the fm-logfire-token Secret, and the
# in-cluster Tempo OTLP endpoint; stable agents ships telemetry-free.
#FM_LOGFIRE=
#LOGFIRE_TOKEN=
#OTEL_EXPORTER_OTLP_ENDPOINT=
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=leads_embeds_v2

# Postgres (used by compose)
POSTGRES_USER=funnel
POSTGRES_PASSWORD=funnel
POSTGRES_DB=funnelmanager
